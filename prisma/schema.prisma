// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Convenciones del proyecto (ver docs/database-reference.md y CLAUDE.md):
// - Modelos en PascalCase singular, fields en camelCase, @map/@@map a snake_case.
// - IDs: UUID v4 con @default(dbgenerated("gen_random_uuid()")) @db.Uuid (pgcrypto).
// - Soft delete: campo `deletedAt DateTime? @db.Timestamptz @map("deleted_at")`.
// - Multi-tenant: campo `tenantId String @db.Uuid @map("tenant_id")` en cada tabla de negocio.
// - Money: Int en cents. Fechas: @db.Timestamptz (UTC).
// - La URL de conexión vive en prisma.config.ts (no acá).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ============================================================================
// ENUMS
// ============================================================================

/// Estado de la suscripción. Compartido por `Subscription.status` (fuente de
/// verdad) y `Tenant.subscriptionStatus` (cache desnormalizada para lecturas).
enum SubscriptionStatus {
  TRIAL    @map("trial")
  ACTIVE   @map("active")
  PAST_DUE @map("past_due")
  CANCELED @map("canceled")
  PAUSED   @map("paused")

  @@map("subscription_status")
}

enum SupportLevel {
  STANDARD @map("standard")
  PRIORITY @map("priority")

  @@map("support_level")
}

enum EmployeeRole {
  OWNER          @map("owner")
  PROFESSIONAL   @map("professional")
  ADMINISTRATIVE @map("administrative")

  @@map("employee_role")
}

enum CancellationRefundType {
  FULL    @map("full")
  PARTIAL @map("partial")
  CREDIT  @map("credit")
  NONE    @map("none")

  @@map("cancellation_refund_type")
}

// ============================================================================
// 1. CUENTAS Y AUTENTICACIÓN
// ============================================================================

/// Usuario que se logea al sistema (owner o empleado).
/// Exento del tenant-scope: es un modelo de auth, no de negocio.
/// `passwordHash` es nullable a propósito: un empleado invitado tiene cuenta
/// creada pero todavía no eligió su contraseña. Mientras esté en null NO puede
/// loguearse (`AuthService.login` lo rechaza igual que a un email desconocido,
/// para no delatar qué cuentas existen). Se completa al aceptar la invitación.
model User {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email           String    @unique @db.VarChar(255)
  passwordHash    String?   @map("password_hash") @db.VarChar(255)
  firstName       String    @map("first_name") @db.VarChar(100)
  lastName        String    @map("last_name") @db.VarChar(100)
  phone           String?   @db.VarChar(30)
  emailVerifiedAt DateTime? @map("email_verified_at") @db.Timestamptz
  lastLoginAt     DateTime? @map("last_login_at") @db.Timestamptz
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt       DateTime? @map("deleted_at") @db.Timestamptz

  refreshTokens       RefreshToken[]
  tokens              UserToken[]
  ownedTenant         Tenant?
  employee            Employee?
  createdAppointments Appointment[]

  @@map("users")
}

/// Refresh tokens con rotación y detección de reuso.
/// El token que viaja al cliente es `<id>.<secret>`: se busca la fila por `id`
/// y se valida el `secret` con argon2 contra `tokenHash` (un hash con salt no
/// se puede buscar por igualdad). `familyId` agrupa toda la cadena de
/// rotaciones: si llega un token ya revocado, se revoca la familia entera.
model RefreshToken {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  familyId  String    @map("family_id") @db.Uuid
  tokenHash String    @map("token_hash") @db.VarChar(255)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

/// Para qué sirve el token. Los dos casos comparten tabla porque comparten
/// todo lo que importa: forma (`<id>.<secret>`), un solo uso, vencimiento y la
/// regla de que emitir uno nuevo revoca el anterior. Lo único que cambia es la
/// vida útil y a qué pantalla del frontend apunta el link.
enum UserTokenPurpose {
  PASSWORD_RESET
  EMAIL_VERIFICATION

  @@map("user_token_purpose")
}

/// Tokens de un solo uso que se le mandan al usuario por mail.
///
/// No lleva `tenantId`: cuelga de `User`, que es global (una persona podría
/// llegar a trabajar en dos negocios). Por eso está en `TENANT_EXEMPT_MODELS`,
/// igual que `RefreshToken`.
///
/// La invitación de empleados NO usa esta tabla: `employee_invitations` apunta
/// a un `Employee` y sí está scopeada por tenant.
model UserToken {
  id        String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String           @map("user_id") @db.Uuid
  purpose   UserTokenPurpose
  tokenHash String           @map("token_hash") @db.VarChar(255)
  expiresAt DateTime         @map("expires_at") @db.Timestamptz
  usedAt    DateTime?        @map("used_at") @db.Timestamptz
  revokedAt DateTime?        @map("revoked_at") @db.Timestamptz
  createdAt DateTime         @default(now()) @map("created_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose])
  @@index([expiresAt])
  @@map("user_tokens")
}

// ============================================================================
// 2. PLANES Y SUSCRIPCIONES
// ============================================================================

/// Catálogo global de planes. Exento del tenant-scope.
/// Los campos nullables (`price*`, `max*`) representan "a medida / sin límite":
/// hoy solo los usa el plan Empresa, que se cotiza contactando a soporte.
model Plan {
  id                    String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                  String       @db.VarChar(50)
  slug                  String       @unique @db.VarChar(50)
  priceMonthlyCents     Int?         @map("price_monthly_cents")
  priceYearlyCents      Int?         @map("price_yearly_cents")
  maxEmployees          Int?         @map("max_employees")
  maxBranches           Int?         @map("max_branches")
  includesClinicRecords Boolean      @default(false) @map("includes_clinic_records")
  includesResources     Boolean      @default(false) @map("includes_resources")
  supportLevel          SupportLevel @default(STANDARD) @map("support_level")
  isActive              Boolean      @default(true) @map("is_active")
  displayOrder          Int          @default(0) @map("display_order")
  createdAt             DateTime     @default(now()) @map("created_at") @db.Timestamptz
  updatedAt             DateTime     @updatedAt @map("updated_at") @db.Timestamptz

  tenants       Tenant[]
  subscriptions Subscription[]

  @@map("plans")
}

/// Historial de suscripciones del tenant. Es la fuente de verdad del estado;
/// `Tenant.subscriptionStatus` es la copia desnormalizada para lecturas rápidas.
model Subscription {
  id                 String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId           String             @map("tenant_id") @db.Uuid
  planId             String             @map("plan_id") @db.Uuid
  status             SubscriptionStatus @default(TRIAL)
  mpSubscriptionId   String?            @unique @map("mp_subscription_id") @db.VarChar(100)
  currentPeriodStart DateTime           @map("current_period_start") @db.Timestamptz
  currentPeriodEnd   DateTime           @map("current_period_end") @db.Timestamptz
  canceledAt         DateTime?          @map("canceled_at") @db.Timestamptz
  createdAt          DateTime           @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime           @updatedAt @map("updated_at") @db.Timestamptz

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  plan   Plan   @relation(fields: [planId], references: [id], onDelete: Restrict)

  @@index([tenantId])
  @@index([status])
  @@map("subscriptions")
}

// ============================================================================
// 3. NEGOCIO (TENANT)
// ============================================================================

/// El negocio. NO lleva `tenantId` (él ES el tenant), por eso está en
/// TENANT_EXEMPT_MODELS: los services lo filtran por `id`.
model Tenant {
  id                 String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ownerUserId        String             @unique @map("owner_user_id") @db.Uuid
  planId             String             @map("plan_id") @db.Uuid
  businessName       String             @map("business_name") @db.VarChar(120)
  slug               String             @unique @db.VarChar(63)
  subscriptionStatus SubscriptionStatus @default(TRIAL) @map("subscription_status")
  trialEndsAt        DateTime?          @map("trial_ends_at") @db.Timestamptz
  timezone           String             @default("America/Argentina/Buenos_Aires") @db.VarChar(64)
  currency           String             @default("ARS") @db.VarChar(3)
  language           String             @default("es") @db.VarChar(5)
  createdAt          DateTime           @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime           @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt          DateTime?          @map("deleted_at") @db.Timestamptz

  owner User @relation(fields: [ownerUserId], references: [id], onDelete: Restrict)
  plan  Plan @relation(fields: [planId], references: [id], onDelete: Restrict)

  branding            TenantBranding?
  settings            TenantSettings?
  employees           Employee[]
  subscriptions       Subscription[]
  branches            Branch[]
  branchBusinessHours BranchBusinessHour[]
  branchSpecialDays   BranchSpecialDay[]
  employeeInvitations EmployeeInvitation[]
  employeeBranches    EmployeeBranch[]
  employeeSchedules   EmployeeSchedule[]
  employeeTimeOff     EmployeeTimeOff[]
  serviceCategories   ServiceCategory[]
  services            Service[]
  employeeServices    EmployeeService[]
  resources           Resource[]
  serviceResources    ServiceResource[]
  customers           Customer[]
  customerTags        CustomerTag[]
  customerTagLinks    CustomerTagAssignment[]
  appointments        Appointment[]
  appointmentServices AppointmentService[]
  appointmentResource AppointmentResource[]
  recurrenceGroups    RecurrenceGroup[]

  @@index([planId])
  @@map("tenants")
}

/// Personalización visual del portal público (Fase 7). Relación 1:1 con Tenant.
model TenantBranding {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId     String   @unique @map("tenant_id") @db.Uuid
  logoUrl      String?  @map("logo_url") @db.VarChar(500)
  primaryColor String?  @map("primary_color") @db.VarChar(7)
  displayName  String   @map("display_name") @db.VarChar(120)
  description  String?  @db.Text
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("tenant_branding")
}

/// Configuración operativa del negocio. Relación 1:1 con Tenant.
/// La política de cancelación la consumen las Fases 5 y 6.
model TenantSettings {
  id                           String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId                     String                 @unique @map("tenant_id") @db.Uuid
  cancellationPolicyHours      Int                    @default(24) @map("cancellation_policy_hours")
  cancellationRefundType       CancellationRefundType @default(FULL) @map("cancellation_refund_type")
  cancellationRefundPercentage Int?                   @map("cancellation_refund_percentage")
  requireDepositForBooking     Boolean                @default(false) @map("require_deposit_for_booking")
  defaultBufferMinutes         Int                    @default(0) @map("default_buffer_minutes")
  createdAt                    DateTime               @default(now()) @map("created_at") @db.Timestamptz
  updatedAt                    DateTime               @updatedAt @map("updated_at") @db.Timestamptz

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("tenant_settings")
}

// ============================================================================
// 4. SUCURSALES
// ============================================================================

/// Sucursal física del negocio. Un tenant puede tener varias según el plan
/// (`Plan.maxBranches`, null = sin límite): el chequeo vive en BranchesService.
///
/// `isActive` y `deletedAt` NO son lo mismo: una sucursal inactiva sigue
/// existiendo (cerrada por refacción, por temporada) y sigue ocupando un lugar
/// del plan; una borrada desaparece de las listas.
model Branch {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String    @map("tenant_id") @db.Uuid
  name      String    @db.VarChar(120)
  address   String?   @db.VarChar(255)
  phone     String?   @db.VarChar(30)
  isActive  Boolean   @default(true) @map("is_active")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  businessHours     BranchBusinessHour[]
  specialDays       BranchSpecialDay[]
  employeeBranches  EmployeeBranch[]
  employeeSchedules EmployeeSchedule[]
  employeeTimeOff   EmployeeTimeOff[]
  employeeServices  EmployeeService[]
  resources         Resource[]
  appointments      Appointment[]

  @@index([tenantId])
  @@map("branches")
}

/// Horario de atención semanal: exactamente 7 filas por sucursal, una por día
/// (`dayOfWeek` 0 = domingo … 6 = sábado). Las 7 nacen con la sucursal y no se
/// crean ni se borran de a una: se reemplaza la semana entera.
///
/// `opensAt`/`closesAt` son TIME (hora de pared, sin fecha ni zona): la zona
/// horaria del negocio vive en `Tenant.timezone`. En un día cerrado van en
/// null; el CHECK de la migración obliga a que sea todo o nada.
///
/// Limitación conocida: `closesAt > opensAt` no admite cruzar la medianoche
/// (un local que cierra a las 02:00). No aplica al rubro hoy; si algún día
/// hace falta, se resuelve con una fila extra para el tramo después de las 00.
model BranchBusinessHour {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String    @map("tenant_id") @db.Uuid
  branchId  String    @map("branch_id") @db.Uuid
  dayOfWeek Int       @map("day_of_week") @db.SmallInt
  opensAt   DateTime? @map("opens_at") @db.Time(0)
  closesAt  DateTime? @map("closes_at") @db.Time(0)
  isClosed  Boolean   @default(false) @map("is_closed")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@unique([branchId, dayOfWeek])
  @@index([tenantId])
  @@map("branch_business_hours")
}

/// Excepción al horario semanal para una fecha puntual: feriado, vacaciones o
/// jornada con horario especial. Pisa a `BranchBusinessHour` para ese día.
///
/// `isClosed = true` (el caso común) es un feriado y va sin horas.
/// `isClosed = false` es una jornada con horario distinto y las exige.
model BranchSpecialDay {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String    @map("tenant_id") @db.Uuid
  branchId    String    @map("branch_id") @db.Uuid
  date        DateTime  @db.Date
  isClosed    Boolean   @default(true) @map("is_closed")
  opensAt     DateTime? @map("opens_at") @db.Time(0)
  closesAt    DateTime? @map("closes_at") @db.Time(0)
  description String?   @db.VarChar(255)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@unique([branchId, date])
  @@index([tenantId])
  @@map("branch_special_days")
}

// ============================================================================
// 5. EMPLEADOS (versión mínima — se completa en la Fase 2.2)
// ============================================================================

/// El dueño del negocio es una fila más de esta tabla, con `isOwner = true`.
/// `userId` es UNIQUE (no compuesto con `tenantId`) porque hoy un usuario
/// pertenece a un solo negocio; si algún día soportamos multi-negocio, se
/// reemplaza por @@unique([tenantId, userId]).
/// La migración agrega además un índice parcial: un solo owner activo por tenant.
model Employee {
  id        String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String       @map("tenant_id") @db.Uuid
  userId    String       @unique @map("user_id") @db.Uuid
  role      EmployeeRole @default(PROFESSIONAL)
  isOwner   Boolean      @default(false) @map("is_owner")
  isActive  Boolean      @default(true) @map("is_active")
  hiredAt   DateTime?    @map("hired_at") @db.Date
  bio       String?      @db.Text
  avatarUrl String?      @map("avatar_url") @db.VarChar(500)
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime     @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt DateTime?    @map("deleted_at") @db.Timestamptz

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Restrict)

  branches     EmployeeBranch[]
  schedules    EmployeeSchedule[]
  timeOff      EmployeeTimeOff[]
  invitations  EmployeeInvitation[]
  services     EmployeeService[]
  appointments Appointment[]

  @@index([tenantId])
  @@map("employees")
}

/// Invitación para que un empleado nuevo se cree la contraseña.
///
/// Mismo esquema que `RefreshToken`: el token que viaja es `<id>.<secret>` —
/// se busca la fila por `id` y se valida el `secret` con argon2 contra
/// `tokenHash`, porque un hash con salt no se puede buscar por igualdad.
///
/// Se acepta una sola vez (`acceptedAt`) y vence. Reinvitar a alguien emite una
/// fila nueva e invalida las anteriores.
model EmployeeInvitation {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId   String    @map("tenant_id") @db.Uuid
  employeeId String    @map("employee_id") @db.Uuid
  tokenHash  String    @map("token_hash") @db.VarChar(255)
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz
  acceptedAt DateTime? @map("accepted_at") @db.Timestamptz
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId])
  @@index([tenantId])
  @@index([expiresAt])
  @@map("employee_invitations")
}

/// En qué sucursales trabaja cada empleado. Tabla de unión pura, sin soft
/// delete: desasignar una sucursal es borrar la fila.
model EmployeeBranch {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  employeeId String   @map("employee_id") @db.Uuid
  branchId   String   @map("branch_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  branch   Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@unique([employeeId, branchId])
  @@index([tenantId])
  @@index([branchId])
  @@map("employee_branches")
}

/// Horario semanal del empleado, que puede ser distinto en cada sucursal.
///
/// A diferencia de `BranchBusinessHour`, acá NO hay una fila por día: hay una
/// por TRAMO. Un profesional que trabaja de 09:00 a 13:00 y de 16:00 a 20:00
/// lleva dos filas del mismo día (turno partido, moneda corriente en el rubro).
/// Un día sin filas es un día que no trabaja. Que los tramos no se pisen lo
/// valida el service; la base solo exige que cada uno termine después de
/// empezar.
model EmployeeSchedule {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  employeeId String   @map("employee_id") @db.Uuid
  branchId   String   @map("branch_id") @db.Uuid
  dayOfWeek  Int      @map("day_of_week") @db.SmallInt
  startsAt   DateTime @map("starts_at") @db.Time(0)
  endsAt     DateTime @map("ends_at") @db.Time(0)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  branch   Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@index([employeeId, branchId, dayOfWeek])
  @@index([tenantId])
  @@map("employee_schedules")
}

/// Vacaciones, licencias y bloqueos personales.
///
/// `branchId` en null significa "en todas las sucursales", que es el caso
/// normal: el que se va de vacaciones no atiende en ninguna.
///
/// Acá `startsAt`/`endsAt` SÍ son instantes (`TIMESTAMPTZ`), no hora de pared:
/// una ausencia arranca un día y termina otro.
model EmployeeTimeOff {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId   String    @map("tenant_id") @db.Uuid
  employeeId String    @map("employee_id") @db.Uuid
  branchId   String?   @map("branch_id") @db.Uuid
  startsAt   DateTime  @map("starts_at") @db.Timestamptz
  endsAt     DateTime  @map("ends_at") @db.Timestamptz
  reason     String?   @db.VarChar(255)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt  DateTime? @map("deleted_at") @db.Timestamptz

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  branch   Branch?  @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@index([employeeId, startsAt])
  @@index([tenantId])
  @@map("employee_time_off")
}

// ─────────────────────────────── Fase 3: catálogo ───────────────────────────

model ServiceCategory {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId     String    @map("tenant_id") @db.Uuid
  name         String    @db.VarChar(120)
  displayOrder Int       @default(0) @map("display_order")
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt    DateTime? @map("deleted_at") @db.Timestamptz

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  services Service[]

  @@index([tenantId])
  @@map("service_categories")
}

model Service {
  id                 String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId           String    @map("tenant_id") @db.Uuid
  categoryId         String?   @map("category_id") @db.Uuid
  name               String    @db.VarChar(120)
  description        String?   @db.Text
  durationMinutes    Int       @map("duration_minutes")
  priceCents         Int       @map("price_cents")
  depositAmountCents Int?      @map("deposit_amount_cents")
  bufferAfterMinutes Int       @default(0) @map("buffer_after_minutes")
  color              String?   @db.VarChar(7)
  isActive           Boolean   @default(true) @map("is_active")
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt          DateTime? @map("deleted_at") @db.Timestamptz

  tenant   Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  category ServiceCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  employeeServices    EmployeeService[]
  serviceResources    ServiceResource[]
  appointmentServices AppointmentService[]

  @@index([tenantId])
  @@index([categoryId])
  @@map("services")
}

model EmployeeService {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  employeeId String   @map("employee_id") @db.Uuid
  serviceId  String   @map("service_id") @db.Uuid
  branchId   String   @map("branch_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  service  Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  branch   Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@unique([employeeId, serviceId, branchId])
  @@index([tenantId])
  @@index([serviceId])
  @@index([branchId])
  @@map("employee_services")
}

model Resource {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String    @map("tenant_id") @db.Uuid
  branchId    String    @map("branch_id") @db.Uuid
  name        String    @db.VarChar(120)
  description String?   @db.Text
  isActive    Boolean   @default(true) @map("is_active")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  serviceResources     ServiceResource[]
  appointmentResources AppointmentResource[]

  @@index([tenantId])
  @@index([branchId])
  @@map("resources")
}

model ServiceResource {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  serviceId  String   @map("service_id") @db.Uuid
  resourceId String   @map("resource_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  service  Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  resource Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)

  @@unique([serviceId, resourceId])
  @@index([tenantId])
  @@index([resourceId])
  @@map("service_resources")
}

// ─────────────────────────────── Fase 4: clientes ───────────────────────────

/// Cliente del negocio. No se logea: lo carga el mostrador, o se autogenera al
/// reservar por el portal público (Fase 7).
///
/// La identidad de un cliente es su TELÉFONO, no su nombre ni su email: es lo
/// único que el mostrador siempre pide y lo que permite reconocer a alguien que
/// vuelve. Por eso hay un unique parcial sobre `(tenant_id, phone_normalized)`
/// y `POST /customers` devuelve 409 con la ficha existente en vez de crear un
/// duplicado.
///
/// `phone` guarda lo que la persona tipeó ("+54 9 11 1234-5678"); el que manda
/// para comparar es `phoneNormalized`, que lo calcula el servicio. Ver
/// `normalizePhone` en `src/common/utils/phone.util.ts`.
///
/// El email NO es único a propósito: una madre y su hija comparten casilla más
/// seguido de lo que uno esperaría. Tiene índice solo para buscar rápido.
model Customer {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId        String    @map("tenant_id") @db.Uuid
  firstName       String    @map("first_name") @db.VarChar(100)
  lastName        String?   @map("last_name") @db.VarChar(100)
  phone           String    @db.VarChar(30)
  phoneNormalized String    @map("phone_normalized") @db.VarChar(30)
  email           String?   @db.VarChar(255)
  dateOfBirth     DateTime? @map("date_of_birth") @db.Date
  notes           String?   @db.Text
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt       DateTime? @map("deleted_at") @db.Timestamptz

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  tagAssignments CustomerTagAssignment[]
  appointments   Appointment[]

  @@index([tenantId])
  @@index([tenantId, phoneNormalized])
  @@index([tenantId, email])
  @@map("customers")
}

/// Etiqueta para segmentar clientes ("VIP", "Debe seña", "Alérgica al amoníaco").
/// El color es `#RRGGBB` y lo usa el front para pintar el chip.
model CustomerTag {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String    @map("tenant_id") @db.Uuid
  name      String    @db.VarChar(60)
  color     String?   @db.VarChar(7)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  assignments CustomerTagAssignment[]

  @@index([tenantId])
  @@map("customer_tags")
}

/// Qué etiquetas tiene cada cliente. Tabla de unión, exenta de soft delete:
/// sacar una etiqueta es sacarla, no archivarla.
model CustomerTagAssignment {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  customerId String   @map("customer_id") @db.Uuid
  tagId      String   @map("tag_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz

  tenant   Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer Customer    @relation(fields: [customerId], references: [id], onDelete: Cascade)
  tag      CustomerTag @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@unique([customerId, tagId])
  @@index([tenantId])
  @@index([tagId])
  @@map("customer_tag_assignments")
}

// ─────────────────────────────── Fase 5: turnos ─────────────────────────────

/// Estados de un turno. Los tres últimos son terminales.
///
/// Los que NO bloquean la agenda (`canceled_*` y `rescheduled`) están agrupados
/// en `NON_BLOCKING_STATUSES` (`src/modules/appointments/availability.ts`) y en
/// el `WHERE` de los EXCLUDE de la migración. **Los dos tienen que decir lo
/// mismo**: si se agrega un estado, hay que tocar los dos lados.
enum AppointmentStatus {
  PENDING_PAYMENT      @map("pending_payment")
  CONFIRMED            @map("confirmed")
  ATTENDED             @map("attended")
  NO_SHOW              @map("no_show")
  CANCELED_BY_CUSTOMER @map("canceled_by_customer")
  CANCELED_BY_BUSINESS @map("canceled_by_business")
  RESCHEDULED          @map("rescheduled")

  @@map("appointment_status")
}

/// De dónde salió el turno. `PUBLIC_BOOKING` lo va a usar el portal (Fase 7).
enum AppointmentSource {
  ADMIN          @map("admin")
  PUBLIC_BOOKING @map("public_booking")
  RECURRING      @map("recurring")

  @@map("appointment_source")
}

enum RecurrenceFrequency {
  WEEKLY   @map("weekly")
  BIWEEKLY @map("biweekly")
  MONTHLY  @map("monthly")

  @@map("recurrence_frequency")
}

/// Un turno.
///
/// `startsAt`/`endsAt` son instantes (`TIMESTAMPTZ`), no hora de pared: la hora
/// que ve el negocio sale de convertirlos a `Tenant.timezone`. `endsAt` incluye
/// el `bufferAfterMinutes` del servicio, porque el profesional sigue ocupado
/// durante el buffer.
///
/// El doble-booking lo impide un EXCLUDE constraint de Postgres sobre
/// `(employee_id, tstzrange(starts_at, ends_at))`, no el código: dos requests
/// simultáneas al mismo slot pasan las dos la validación previa, y solo la base
/// puede desempatar. Ver la migración.
model Appointment {
  id                 String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId           String            @map("tenant_id") @db.Uuid
  branchId           String            @map("branch_id") @db.Uuid
  employeeId         String            @map("employee_id") @db.Uuid
  customerId         String            @map("customer_id") @db.Uuid
  startsAt           DateTime          @map("starts_at") @db.Timestamptz
  endsAt             DateTime          @map("ends_at") @db.Timestamptz
  status             AppointmentStatus @default(CONFIRMED)
  totalPriceCents    Int               @map("total_price_cents")
  depositAmountCents Int?              @map("deposit_amount_cents")
  depositPaid        Boolean           @default(false) @map("deposit_paid")
  notes              String?           @db.Text
  createdByUserId    String?           @map("created_by_user_id") @db.Uuid
  createdVia         AppointmentSource @default(ADMIN) @map("created_via")
  recurrenceGroupId  String?           @map("recurrence_group_id") @db.Uuid
  canceledAt         DateTime?         @map("canceled_at") @db.Timestamptz
  cancellationReason String?           @map("cancellation_reason") @db.Text
  createdAt          DateTime          @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime          @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt          DateTime?         @map("deleted_at") @db.Timestamptz

  /// Apunta al turno que este reemplaza. El sentido inverso (`rescheduledTo`)
  /// es la back-reference, NO una segunda columna: el modelo conceptual lista
  /// las dos, pero guardar los dos punteros deja abierta la posibilidad de que
  /// se contradigan. Con uno solo, la relación es consistente por construcción.
  rescheduledFromId String? @unique @map("rescheduled_from_id") @db.Uuid

  tenant          Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch          Branch           @relation(fields: [branchId], references: [id], onDelete: Restrict)
  employee        Employee         @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  customer        Customer         @relation(fields: [customerId], references: [id], onDelete: Restrict)
  createdBy       User?            @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)
  recurrenceGroup RecurrenceGroup? @relation(fields: [recurrenceGroupId], references: [id], onDelete: SetNull)

  rescheduledFrom Appointment? @relation("Reschedule", fields: [rescheduledFromId], references: [id], onDelete: SetNull)
  rescheduledTo   Appointment? @relation("Reschedule")

  services  AppointmentService[]
  resources AppointmentResource[]

  @@index([tenantId, startsAt])
  @@index([employeeId, startsAt])
  @@index([branchId, startsAt])
  @@index([customerId])
  @@index([recurrenceGroupId])
  @@map("appointments")
}

/// Los servicios que incluye un turno.
///
/// `durationMinutes` y `priceCents` son un **snapshot** del servicio al momento
/// de reservar, no una FK al valor de hoy: si mañana sube el precio, el turno de
/// ayer tiene que seguir valiendo lo que valía. Por eso tampoco alcanza con
/// leerlos por la relación.
model AppointmentService {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId        String   @map("tenant_id") @db.Uuid
  appointmentId   String   @map("appointment_id") @db.Uuid
  serviceId       String   @map("service_id") @db.Uuid
  durationMinutes Int      @map("duration_minutes")
  priceCents      Int      @map("price_cents")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz

  tenant      Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  service     Service     @relation(fields: [serviceId], references: [id], onDelete: Restrict)

  @@unique([appointmentId, serviceId])
  @@index([tenantId])
  @@index([serviceId])
  @@map("appointment_services")
}

/// Los recursos que ocupa un turno (la sala, la camilla).
///
/// **`startsAt`, `endsAt` y `blocksSlot` son copia de los del turno.** Están
/// acá porque un EXCLUDE constraint no puede leer otra tabla: Postgres no
/// admite subqueries en un índice. Sin la copia no hay forma de impedir a nivel
/// base que dos turnos solapados reserven la misma sala.
///
/// El precio de eso es que se pueden desincronizar, así que **hay un solo lugar
/// que las escribe**: `AppointmentsService.syncResourceMirror`. Cualquier cambio
/// de horario o de estado del turno tiene que pasar por ahí.
model AppointmentResource {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId      String   @map("tenant_id") @db.Uuid
  appointmentId String   @map("appointment_id") @db.Uuid
  resourceId    String   @map("resource_id") @db.Uuid
  startsAt      DateTime @map("starts_at") @db.Timestamptz
  endsAt        DateTime @map("ends_at") @db.Timestamptz
  blocksSlot    Boolean  @default(true) @map("blocks_slot")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz

  tenant      Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  resource    Resource    @relation(fields: [resourceId], references: [id], onDelete: Restrict)

  @@unique([appointmentId, resourceId])
  @@index([tenantId])
  @@index([resourceId, startsAt])
  @@map("appointment_resources")
}

/// La regla de una serie de turnos repetidos. Los turnos se generan de a uno y
/// quedan atados por `recurrenceGroupId`; borrar el grupo no los borra.
model RecurrenceGroup {
  id          String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String              @map("tenant_id") @db.Uuid
  frequency   RecurrenceFrequency
  dayOfWeek   Int?                @map("day_of_week") @db.SmallInt
  occurrences Int
  createdAt   DateTime            @default(now()) @map("created_at") @db.Timestamptz

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  appointments Appointment[]

  @@index([tenantId])
  @@map("recurrence_groups")
}
