# Entorno de Node — development | production | test
NODE_ENV=development

# Puerto donde escucha el server
PORT=3001

# Connection string de Postgres
# Para dev local apuntando al Docker Compose de este repo:
DATABASE_URL="postgresql://agendapp:agendapp_dev_password@localhost:5432/agendapp?schema=public"
#
# ⚠️ EN PRODUCCIÓN ESTO NO VA CON EL ROL DUEÑO.
# Las tablas tienen Row Level Security, y un superusuario (o el dueño de la
# tabla) la ignora por completo: las políticas quedarían puestas sin cortar
# nada. Creá el rol restringido con `npm run db:rls-role` y apuntá esto ahí.
# Las migraciones y los seeds siguen yendo con el rol dueño.
# Ver "Aislamiento entre negocios (RLS)" en el README.

# --- Auth ---
# Secreto para firmar los access tokens (mínimo 32 caracteres).
# Generar uno nuevo con: openssl rand -base64 48
JWT_SECRET="cambiame-por-un-secreto-largo-de-al-menos-32-chars"
# Vida del access token (formato de ms/vercel: 15m, 1h, 7d)
JWT_ACCESS_EXPIRES_IN=15m
# Vida del refresh token, en días
REFRESH_TOKEN_TTL_DAYS=7

# Orígenes que pueden llamar a la API desde un navegador, separados por coma.
# En dev, el Next del frontend. En producción, el dominio real (nunca *).
CORS_ORIGINS="http://localhost:3000"

# --- Negocio ---
# Días de prueba de un tenant recién registrado
TRIAL_DAYS=14

# Base de las URLs que ve el usuario final (el frontend, no esta API).
# De acá sale el link de activación que se le pasa a un empleado invitado.
APP_BASE_URL="http://localhost:3000"

# Vida del link de invitación de un empleado, en horas
EMPLOYEE_INVITATION_TTL_HOURS=72

# --- Mail ---
# log    → no manda nada, escribe el mail y sus links en la consola (default)
# resend → envía de verdad vía https://resend.com
MAIL_PROVIDER=log

# Obligatoria si MAIL_PROVIDER=resend. Se saca del panel de Resend.
# RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxxxxx"

# Remitente. Con Resend, el dominio tiene que estar verificado (SPF + DKIM);
# sin verificar solo se puede mandar a la casilla de la propia cuenta.
MAIL_FROM="AgendApp <onboarding@resend.dev>"

# Vida del link de reset de contraseña, en minutos
PASSWORD_RESET_TTL_MINUTES=60

# Vida del link de verificación de email, en horas
EMAIL_VERIFICATION_TTL_HOURS=48

# --- Pagos ---
# sandbox     → no cobra nada; cada checkout deja un pago ya aprobado esperando
#               al webhook, y el paymentId sale por el log (default)
# mercadopago → cobra de verdad
PAYMENT_PROVIDER=sandbox

# Obligatorios si PAYMENT_PROVIDER=mercadopago.
# El token de prueba empieza con TEST- y hace que se use el checkout de sandbox.
# MP_ACCESS_TOKEN="TEST-0000000000000000-000000-00000000000000000000000000000000-000000000"
# El secreto de firma sale del panel de webhooks de MP. Sin él, el webhook es un
# endpoint público donde cualquiera puede avisar "esto ya se pagó".
# MP_WEBHOOK_SECRET="..."

# La URL pública de ESTA API: la que Mercado Pago usa para avisar de un pago.
# No es APP_BASE_URL, que es el frontend. En desarrollo MP no puede alcanzar
# localhost: hace falta un túnel (ngrok o similar) y poner acá la URL que dé.
API_PUBLIC_URL="http://localhost:3001"

# Días de atraso que se le toleran a un negocio antes de bloquearle el alta de
# turnos nuevos. Nunca se bloquea la lectura ni la cancelación.
SUBSCRIPTION_GRACE_DAYS=7
