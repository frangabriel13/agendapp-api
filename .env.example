# Entorno de Node — development | production | test
NODE_ENV=development

# Puerto donde escucha el server
PORT=3001

# Connection string de Postgres
# Para dev local apuntando al Docker Compose de este repo:
DATABASE_URL="postgresql://agendapp:agendapp_dev_password@localhost:5432/agendapp?schema=public"

# --- Auth ---
# Secreto para firmar los access tokens (mínimo 32 caracteres).
# Generar uno nuevo con: openssl rand -base64 48
JWT_SECRET="cambiame-por-un-secreto-largo-de-al-menos-32-chars"
# Vida del access token (formato de ms/vercel: 15m, 1h, 7d)
JWT_ACCESS_EXPIRES_IN=15m
# Vida del refresh token, en días
REFRESH_TOKEN_TTL_DAYS=7

# Orígenes que pueden llamar a la API desde un navegador, separados por coma.
# En dev, el Next del frontend. En producción, el dominio real (nunca *).
CORS_ORIGINS="http://localhost:3000"

# --- Negocio ---
# Días de prueba de un tenant recién registrado
TRIAL_DAYS=14

# Base de las URLs que ve el usuario final (el frontend, no esta API).
# De acá sale el link de activación que se le pasa a un empleado invitado.
APP_BASE_URL="http://localhost:3000"

# Vida del link de invitación de un empleado, en horas
EMPLOYEE_INVITATION_TTL_HOURS=72
